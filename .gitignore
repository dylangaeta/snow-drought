# Served from Cloudflare R2 instead of git/GitHub Pages (see js/common.js's
# assetUrl() and scripts/sync_cogs_to_r2.sh), kept locally only as a dev
# fallback. cogs/ is large binary data; data/ is small individually but
# gets fully rewritten on every pipeline export, so committing it grows
# git history forever with no way to reclaim the space. figures/maps/,
# figures/timeseries/, and figures/seasonal/ are all read by gallery.html.
/cogs/
/data/
/figures/maps/
/figures/timeseries/
/figures/seasonal/

.DS_Store
# macOS custom-folder-icon resource-fork files (literally named "Icon" + a
# trailing carriage return); Finder creates them for any folder given a custom
# icon, and they otherwise litter git status repo-wide.
Icon?

# Live Cloudflare API token + R2 access/secret keys for sync_cogs_to_r2.sh --
# never commit this.
cloudflare_token.txt

# Wrangler CLI's local cache -- account ID/name, no tokens, but local tool
# state doesn't belong in version control regardless.
/.wrangler/
